# ── Copy to .env.local for `npm run dev`. For `npm run cf:preview` put the same
#    names in .dev.vars. In production set them on Cloudflare: Workers & Pages →
#    copper-atlas → Settings → Variables and Secrets (PAYPAL_CLIENT_SECRET and
#    RESEND_API_KEY as type Secret, the rest as Text).

# Where order emails land. Without these the API still accepts orders and logs
# them, and the customer's WhatsApp fallback keeps working.
RESEND_API_KEY=
ORDER_EMAIL_TO=tarik@copperatlasdesign.com
ORDER_EMAIL_FROM=orders@copperatlasdesign.com

# ── PayPal ──────────────────────────────────────────────────────────────────
# The owner gets these from developer.paypal.com → Apps & Credentials. The
# /setup page checks them and prints these exact lines for him to paste.
# Leave empty and checkout stays on the send-the-order / WhatsApp flow.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" = test money (default), "live" = real money
PAYPAL_ENV=sandbox

# Flat shipping in USD for orders under SHOP.freeShippingOver ($400).
# Orders above that always ship free. Empty = 0, and /setup warns about it.
SHIPPING_FLAT_USD=

# Unlocks the owner's hidden /en/setup page. 12+ characters, or the page stays
# switched off. Give it to the owner privately - never in a chat group.
SETUP_PASSWORD=

# Sample reviews for layout preview ONLY. Must stay empty in production —
# publishing invented testimonials is illegal in the US, UK and EU.
NEXT_PUBLIC_DEMO_REVIEWS=
